# Brandon's little helper script
# Not important

case $1 in
    "setup")
        echo "Installing bun" 
        curl -fsSL https://bun.sh/install | bash
        source /home/gitpod/.bashrc
        for dir in ./interapp-*; do (cd "$dir" && bun i); done ;;
    "run")
        mkdir dump minio-dump;
        make build
        make run
        ;;
    "build")
        make build
        ;;
    "stop")
        docker compose -f docker-compose.dev.yml -v down
        ;;
    *)
        echo 'Expected "setup", "run", "build", or "stop"' >&2
        exit 1
esac